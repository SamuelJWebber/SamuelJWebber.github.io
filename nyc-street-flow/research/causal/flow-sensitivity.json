{
  "version": "1.0",
  "checked_on": "2026-11-05",
  "scope": "Partial identification and sensitivity, not an estimate of bike-lane causality.",
  "identification_conclusion": {
    "ppw_all_person_flow_change": "Unidentified from assembled data: walking change, common-date/common-screenline correction, actual occupancy and contemporaneous B69 loads remain unknown. Even the historically anchored stable-occupancy conditional index bounds include zero.",
    "ppw_lane_effect": "Unidentified: additional unrestricted counterfactual trend and concurrent signal/bus changes remain.",
    "brooklyn": "Published representative-profile changes can be computed. Occupancy thresholds for isolated classified dates are conditional motor-only diagnostics; they cannot establish a causal all-mode sign.",
    "pulaski": "No paired classified pre/post conversion panel in assembled extract; 2023 classification is after the 2016 conversion. Nearby ATR coverage has incomplete/low-count cases and cannot be treated as valid aligned person flow. Sign unidentified."
  },
  "equations": {
    "full_screenline_change_per_hour": "[o1*V1 - o0*(V0-N0) - N0 - P0 + (B1-B0)]/H + deltaWalking + alignmentCorrection",
    "definitions": "V includes all motor vehicles; o is mean occupants of vehicles other than relocated B69; N0 pre B69 buses; P0 pre B69 passengers excluding drivers; post B69 at PPW is zero; B is cyclists. H=3 hours. deltaWalking and alignmentCorrection are signed people/hour differences.",
    "causal_effect": "target-screenline observed change minus counterfactual change without the intervention.",
    "restrictions_for_numeric_ppw_bounds": "Set walking/alignment changes to zero; use specified occupancy restrictions; transfer historical route maximum load as an upper bound on all three relevant hours; regular scheduled bus counts stand in for actual runs. These are explicit assumptions, not observations."
  },
