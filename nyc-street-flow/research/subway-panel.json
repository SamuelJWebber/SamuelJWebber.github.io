{
  "metadata": {
    "label": "Estimated subway OD trips, both directions",
    "unit": "Trips per average weekday hour",
    "sources": {
      "2021": "https://data.ny.gov/d/rapa-97zv",
      "2022": "https://data.ny.gov/d/nqnz-e9z9",
      "stations": "https://data.ny.gov/d/39hk-dx4f",
      "methods": "https://data.ny.gov/api/views/rapa-97zv/files/11596109-1af7-4a7e-9761-d557634415c6?download=true"
    },
    "method": "Sum estimated OD trips whose origin and inferred destination lie in the two boroughs, both directions. Equally weight Monday\u2013Friday. AM7\u201310 and PM16\u201319 each divide summed five weekday \u00d7 three hour cells by15. Borough mapping uses official complex IDs and same-borough station IDs for historical complexes; all424 observed origin complexes in each year are mapped. No trip records or travelers are linked across years.",
    "caveats": [
      "These are inferred OD estimates from return taps/swipes, scaled to origin entries; individual pairs are not exact counts.",
      "No actual route, bridge/tunnel, exact trip date, previous mode, exit timestamp or door-to-door time is supplied.",
      "Monthly averages include holidays; they cannot isolate June1\u201320 or other exact-day samples.",
      "Published data contain populated OD pairs; January2021 has absent overnight cells. Daily totals are withheld where weekday24-hour coverage is incomplete. All AM and PM cells used here are present.",
      "Current station registry is applied to historical IDs; all observed IDs map, but this does not independently validate inferred destinations.",
      "A broad borough-pair recovery series is contextual; it does not identify a bike-lane effect or individual mode switching."
    ]
  },
