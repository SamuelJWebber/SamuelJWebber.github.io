{"visibility": "domain", "fields": [{"name": "id_trajectoire", "description": "Identifiant unique de la trajectoire - Concat\u00e9nation [id_site]_[trajectoire]", "annotations": {"sortable": true}, "label": "Identifiant trajectoire", "type": "text"}, {"name": "id_site", "description": "Identifiant du site du comptage", "annotations": {"facetsort": "-count", "sortable": true}, "label": "Identifiant site", "type": "text"}, {"name": "label", "description": "Champ issu du jeu de donn\u00e9es - Sites et trajectoires de comptage - Libell\u00e9 du site de comptage", "annotations": {"sortable": true, "facet": true, "facetsort": "alphanum", "disjunctive": true}, "label": "Nom du site", "type": "text"}, {"name": "t", "description": "Horodate de d\u00e9but du comptage horaire", "annotations": {"facet": true, "facetsort": "-alphanum", "timeserie_precision": "hour", "timerangeFilter": true}, "label": "Date et heure de comptage", "type": "datetime"}, {"name": "mode", "description": "Mode de d\u00e9placement des usagers", "annotations": {"facet": true, "facetsort": "alphanum", "disjunctive": true, "sortable": true}, "label": "Mode d\u00e9placement", "type": "text"}, {"name": "nb_usagers", "description": "Nombre de v\u00e9hicules comptabilis\u00e9s par heure, site et trajectoire", "annotations": {}, "label": "Nombre de v\u00e9hicules", "type": "int"}, {"name": "voie", "description": "Champ issu du jeu de donn\u00e9es - Sites et trajectoires de comptage - Types de voie sur lesquels le site comptabilise les mobilit\u00e9s", "annotations": {"facet": true, "facetsort": "alphanum", "disjunctive": true, "sortable": true}, "label": "Type voie", "type": "text"}, {"name": "sens", "description": "Champ issu du jeu de donn\u00e9es - Sens de comptage synth\u00e9tis\u00e9 par les points cardinaux. (ex : N-S > Nord - Sud, ou NO-SE > Nord Ouest - Sud Est)", "annotations": {"facet": true, "facetsort": "alphanum", "disjunctive": true, "sortable": true}, "label": "Sens de circulation", "type": "text"}, {"name": "trajectoire", "description": "Description de la trajectoire - File de circulation en entr\u00e9e -> File de circulation en sortie", "annotations": {"facet": true, "facetsort": "alphanum", "disjunctive": true, "sortable": true}, "label": "Trajectoire", "type": "text"}, {"name": "coordonnees_geo", "description": "Champ issu du jeu de donn\u00e9es - Sites et trajectoires de comptage - Localisation du site du comptage en WGS84", "annotations": {}, "label": "Coordonn\u00e9es G\u00e9o", "type": "geo_point_2d"}], "dataset_id": "comptage-multimodal-comptages", "dataset_uid": "da_g5dexn", "has_records": true, "features": ["timeserie", "analyze", "geo", "custom_view"], "attachments": [{"id": "documentation_v3_1_pdf", "title": "documentation_V3.1.pdf", "mimetype": "application/pdf", "url": "https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/comptage-multimodal-comptages/attachments/documentation_v3_1_pdf"}], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Comptage multimodal (V\u00e9lo, Trottinette, 2RM, VL, PL, Autobus-car) - Comptages", "description": "<p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\"><b style=\"font-size: 0.875rem;\">Jeu de donn\u00e9es des comptages multimodaux horaires par mode de d\u00e9placement issus de capteurs thermiques.</b><br/></p><p class=\"p2\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial; min-height: 16px;\"><br/></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\">La Ville de Paris collecte des donn\u00e9es de comptages de v\u00e9hicules par :</p><ul class=\"ul1\" style=\"font-size: medium;\"><li class=\"li3\" style=\"margin: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; font-size: 14px; line-height: normal; font-family: Arial;\"><span class=\"s1\"><b>Modes de d\u00e9placements</b> (Trottinettes, Trottinettes + V\u00e9los (lorsque la distinction entre ces 2 modes de d\u00e9placement n\u2019est pas impl\u00e9ment\u00e9 sur le capteur), V\u00e9los, 2 roues motoris\u00e9es, V\u00e9hicules l\u00e9gers &lt; 3,5 tonnes, V\u00e9hicules lourds &gt; 3,5 tonnes, Autobus &amp; autocars),</span></li><li class=\"li3\" style=\"margin: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; font-size: 14px; line-height: normal; font-family: Arial;\"><span class=\"s1\"><b>Types de file de circulation</b> (Corona-pistes, Pistes cyclables, Voies de circulation g\u00e9n\u00e9rales),</span></li><li class=\"li3\" style=\"margin: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; font-size: 14px; line-height: normal; font-family: Arial;\"><span class=\"s1\"><b>Sens de circulation</b>.</span></li></ul><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\">Ces donn\u00e9es sont construites en exploitant un <b>algorithme d\u2019intelligence artificielle</b> qui analyse les images issues de cam\u00e9ras thermiques install\u00e9es sur l\u2019espace public.</p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\"><b>Les images issues de cam\u00e9ras thermiques ne permettent pas d\u2019identifier des visages ou des plaques d\u2019immatriculation. Les donn\u00e9es ainsi collect\u00e9es ne pr\u00e9sentent pas de donn\u00e9es \u00e0 caract\u00e8re personnel ou individuel.</b></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\">Aucune image n\u2019est transf\u00e9r\u00e9e ni stock\u00e9e sur des serveurs informatiques, l\u2019analyse \u00e9tant effectu\u00e9e au plus pr\u00e8s de la cam\u00e9ra thermique. Seules les donn\u00e9es de comptages sont transmises.<span class=\"Apple-converted-space\">\u00a0</span></p><p class=\"p4\" style=\"margin-bottom: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial; min-height: 16px;\"><br/></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\">Ce jeu de donn\u00e9es est aliment\u00e9 par le comptage effectu\u00e9 par les capteurs et le jeu de donn\u00e9es d\u00e9crivant les trajectoires des sites de comptage <a href=\"https://parisdata.opendatasoft.com/explore/dataset/comptage-multimodal-sites-et-trajectoires-de-comptage/information/?disjunctive.voie&amp;disjunctive.sens&amp;disjunctive.trajectoire\"><span class=\"s2\" style=\"text-decoration-line: underline;\"><b>Comptage multimodal - Sites et trajectoires de comptage</b></span></a></p><p class=\"p2\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial; min-height: 16px;\"><br/></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\"><b>Le nombre de capteurs et leur capacit\u00e9 \u00e0 distinguer le type de v\u00e9hicules (ex trottinettes et v\u00e9los) peuvent \u00e9voluer dans le temps.\u00a0</b></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\"><b><br/></b></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\"><b>Pr\u00e9cision sur le contenu du champ \u00ab\u00a0Trajectoire\u00a0\u00bb :</b></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\">C\u2019est une chaine de caract\u00e8res d\u00e9signant la zone de d\u00e9but de d\u00e9tection (entr\u00e9e) et la zone de sortie de d\u00e9tection (Entr\u00e9e &gt; Sortie)<span class=\"Apple-converted-space\">\u00a0</span></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\"><b>Une trajectoire est caract\u00e9ris\u00e9e par un sens de circulation et par la file de circulation emprunt\u00e9e par le v\u00e9hicule en entr\u00e9e et en sortie.</b></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\">Exemple : Un v\u00e9lo pouvant dans la zone de d\u00e9tection de la cam\u00e9ra thermique entrer sur la piste cyclable et sortir sur la voie de circulation g\u00e9n\u00e9rale.<span class=\"Apple-converted-space\">\u00a0</span></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\"><span class=\"Apple-converted-space\"><br/></span></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\"><span class=\"Apple-converted-space\">Vous trouverez <b>plus de d\u00e9tail dans la notice en pi\u00e8ce jointe</b> du jeu de donn\u00e9es.</span></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\"><span class=\"Apple-converted-space\"><br/></span></p><p class=\"p1\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial;\"><span class=\"Apple-converted-space\"><br/></span></p><p class=\"p2\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial; min-height: 16px;\"><br/></p><p class=\"p2\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial; min-height: 16px;\"><br/></p><p class=\"p2\" style=\"margin-bottom: 0px; text-align: justify; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal; font-family: Arial; min-height: 16px;\"><br/></p>", "theme": ["Mobilit\u00e9 et Espace Public"], "keyword": ["DVD", "comptage v\u00e9lo", "comptage routier", "IoT", "trottinettes", "v\u00e9lo", "moto", "auto", "2RM", "VL", "PL", "mobilit\u00e9"], "license": "Open Database License (ODbL)", "license_url": "http://opendatacommons.org/licenses/odbl/", "language": "fr", "modified": "2026-11-05T06:15:29+00:00", "publisher": "Direction de la Voirie et des D\u00e9placements - Ville de Paris", "references": null, "attributions": null, "update_frequency": null, "bbox": {"type": "Feature", "geometry": {"coordinates": [[[2.3891548812389374, 48.898589964956045], [2.259379969909787, 48.898589964956045], [2.259379969909787, 48.82232646457851], [2.3891548812389374, 48.82232646457851], [2.3891548812389374, 48.898589964956045]]], "type": "Polygon"}, "properties": {}}, "data_processed": "2026-11-05T06:15:29+00:00", "federated": false, "geographic_reference": ["fr_80_75056"], "geographic_reference_auto": true, "geometry_types": ["Point"], "metadata_languages": ["fr"], "metadata_processed": "2026-11-05T06:15:29.373000+00:00", "modified_updates_on_data_change": true, "modified_updates_on_metadata_change": false, "parent_domain": null, "records_count": 13881080, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": ["Paris"], "timezone": "Europe/Paris"}, "dcat": {"created": "2021-11-08", "issued": "2021-11-08", "creator": "DVD - Service des D\u00e9placements - Section Etudes et Exploitation", "contributor": null, "contact_name": null, "contact_email": null, "accrualperiodicity": "Quotidienne", "spatial": null, "temporal": null, "granularity": null, "dataquality": null, "publisher_type": null, "conforms_to": null, "temporal_coverage_start": null, "temporal_coverage_end": null, "accessRights": null, "relation": null}}}